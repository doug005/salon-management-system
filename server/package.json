    "db:indexes": "node --env-file-if-exists=.env scripts/indexes.js",
    "provision-owner": "node --env-file-if-exists=.env scripts/provision-owner.js",
    "provision-admin": "node --env-file-if-exists=.env scripts/provision-admin.js",
