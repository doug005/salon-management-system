  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.22.0",
    "mongoose": "^8.20.0",
    "nodemailer": "^10.6.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
