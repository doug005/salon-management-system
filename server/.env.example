NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=
# Random values >=32 characters; never commit .env. ADMIN_SETUP_TOKEN enables the one-time admin endpoint.
# Remove ADMIN_SETUP_TOKEN after provisioning. No public privileged registration exists.
# ADMIN_SETUP_TOKEN=
EMAIL_MODE=safe
EMAIL_DELIVERY_APPROVED=no
# Real SMTP requires explicit admin approval AND EMAIL_MODE=smtp AND EMAIL_DELIVERY_APPROVED=yes.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Advertisement storage: development defaults to project-local .local/ad-images.
# Production requires a private S3-compatible bucket; see docs/ADVERTISEMENTS.md.
AD_STORAGE=local
# AD_S3_BUCKET=
# AD_S3_REGION=
# AD_S3_ENDPOINT=
# Supply AWS credentials securely via the SDK provider chain; never commit them.

# Google Identity Services OAuth Web client ID. Optional until configured.
# GOOGLE_CLIENT_ID=
